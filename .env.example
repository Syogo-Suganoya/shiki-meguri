# シキめぐり ローカル設定テンプレート
# 実キーは .env に書き、絶対にコミットしない（本番は Secret Manager → Cloud Run 注入）。

# --- 実行モード（キーが未設定のうちは mock のままで全機能が動く）------------
GEMINI_MODE=mock          # mock | live
YOUCAM_MODE=mock          # mock | live
EKISPERT_MODE=mock        # mock | live
RENTAL_MODE=mock          # MVP は mock 固定（設計書 §9）

# --- データ -----------------------------------------------------------------
# firestore が既定。memory はテスト専用（プロセスが落ちると消える）。
DB_DRIVER=firestore       # firestore | memory
GOOGLE_CLOUD_PROJECT=shiki-meguri-local
# 開発は compose 同梱のエミュレータを指す。本番では設定しない（本物の Firestore を向く）。
FIRESTORE_EMULATOR_HOST=firestore:8200

# --- サービス構成 -----------------------------------------------------------
AGENT_TRANSPORT=inproc    # inproc | http（http は --profile split と併用）

# --- APIキー ----------------------------------------------------------------
GEMINI_API_KEY=
# 提案文の生成は短文なので Flash で足りる。gemini-3.5-flash-lite に落とすとさらに安い。
GEMINI_MODEL=gemini-3.7-flash
YOUCAM_API_KEY=
YOUCAM_SECRET_KEY=
EKISPERT_API_KEY=
EKISPERT_MCP_URL=

# --- ガバナンス（設計書 §7-3）------------------------------------------------
# エージェントが本人承認なしに確定できる金額の上限。0 = 常に同意ゲートを通す。
AGENT_SPEND_LIMIT_YEN=0
