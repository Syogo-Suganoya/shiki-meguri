# シキめぐり ローカル設定テンプレート
# 実キーは .env に書き、絶対にコミットしない（本番は Secret Manager → Cloud Run 注入）。

# --- 実行モード（キーが未設定のうちは mock のままで全機能が動く）------------
GEMINI_MODE=mock          # mock | live
EKISPERT_MODE=mock        # mock | live

# --- APIキー ----------------------------------------------------------------
GEMINI_API_KEY=
# 提案文の生成は短文なので Flash で足りる。gemini-3.5-flash-lite に落とすとさらに安い。
GEMINI_MODEL=gemini-3.7-flash
# 駅すぱあと API のアクセスキー。MCPサーバー経由でもアクセス数・使用料は加算される。
EKISPERT_API_KEY=

